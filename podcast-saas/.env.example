# ── Database ──────────────────────────────────────────────────────────────────
# Supabase / hosted Postgres — copy your full connection string from the dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_saas

# ── Firebase ──────────────────────────────────────────────────────────────────
# Server-side Admin SDK credentials — Firebase Console → Project Settings → Service accounts
# → Generate new private key (downloads a JSON; copy the three fields below from it)
FIREBASE_PROJECT_ID=cebu-1a10f
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@cebu-1a10f.iam.gserviceaccount.com

# Client SDK (public — safe to commit; taken from Firebase Console → Project Settings → General)
NEXT_PUBLIC_FIREBASE_API_KEY=d
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=d
NEXT_PUBLIC_FIREBASE_PROJECT_ID=d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=d
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=d
NEXT_PUBLIC_FIREBASE_APP_ID=d

# ── LLM API Keys (stored encrypted in DB via admin panel; these are fallbacks) ─
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY also powers the Ask-the-Avatar visual engine (images, charts,
# diagrams, equations, simulations) and conversation memory — keep it set.
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# ── Ask-the-Avatar (Anam) ─────────────────────────────────────────────────────
# Live conversational avatar shown above the video when a viewer clicks "Ask!".
# Ported from darwin-avatar. Einstein is the default persona for every video.
#   1. Create an account at https://lab.anam.ai → Settings → API Keys
#   2. Create a persona for each character; copy its persona UUID below
# Without ANAM_API_KEY + a persona, the popup shows a "not configured" message
# but the rest of the app (and the visual Library generation) still works.
ANAM_API_KEY=
# Default persona used for all videos (Einstein). ANAM_PERSONA_ID is a legacy
# fallback used when the per-character ID is unset.
ANAM_PERSONA_ID_EINSTEIN=
ANAM_PERSONA_ID=
# Optional additional characters
ANAM_PERSONA_ID_DARWIN=
ANAM_PERSONA_ID_NAPOLEON=
ANAM_PERSONA_ID_ARCHIMEDES=

# ── ElevenLabs (TTS voice synthesis) ──────────────────────────────────────────
# Set this in the Admin panel → API Keys → ElevenLabs (recommended)
# OR set here as a fallback env var (not used by the app directly — admin panel stores it encrypted in DB)
# Get your key at: https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Optional overrides for the guided-simulation TTS voice/model.
# If unset, the app falls back to the admin-panel voice and eleven_multilingual_v2.
GUIDANCE_TTS_VOICE_ID=
GUIDANCE_TTS_MODEL=

# ── AI Video Generation (B-roll) ─────────────────────────────────────────────
# Kling 3.0 (Kuaishou) — https://klingai.com/global/api
# Create credentials in the Kling developer portal → API Keys
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# Seedance 2.0 (BytePlus ModelArk) — https://docs.byteplus.com/en/docs/ModelArk
# Create an API key in the BytePlus ModelArk console
SEEDANCE_API_KEY=your-bytedance-ark-api-key

# Veo 3 (Google) — uses GOOGLE_GENERATIVE_AI_API_KEY already set above.
# Enable "Generative Language API" in Google Cloud Console and ensure your key
# has access to veo-3.0-generate-preview (may require waitlist approval).
# No additional key needed — GOOGLE_GENERATIVE_AI_API_KEY covers Veo.

# ── Storage backend selection ──────────────────────────────────────────────────
# Optional explicit override: 'supabase' | 'r2' | 'local'. If unset, Supabase Storage
# is used when its S3 creds below are present, else R2 (if real creds), else local disk.
STORAGE_BACKEND=

# ── Storage (Supabase Storage — S3-compatible, the writable provider) ───────────
# NO OWNER ACTION NEEDED — resolved 2026-08-21, and worth knowing WHY it is not a task:
#   Large-video uploads use S3 multipart; if the tab closes mid-upload, the parts are BILLED but
#   invisible to every object LIST, and no code path in this repo can find them (there is no
#   ListMultipartUploads call anywhere). This file used to prescribe a one-time dashboard rule,
#   "abort incomplete multipart uploads after 7 days". Checked against the live dashboard: Supabase
#   exposes no per-bucket lifecycle UI at all, and aborts incomplete multipart uploads
#   automatically after 24 HOURS — stricter than the rule we were going to configure. Nothing to
#   set. (Neither bound can break a real upload: presigned part URLs expire after 1 hour, so any
#   multipart older than that is already dead to its client.)

# Create a bucket in Supabase → Storage, then generate S3 access keys in
# Storage → Settings → S3 access keys. SUPABASE_URL is your project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=media
# Optional — defaults to ${SUPABASE_URL}/storage/v1/s3
SUPABASE_S3_ENDPOINT=

# ── Storage (Cloudflare R2 — currently read-only token; kept as fallback) ───────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=podcast-saas
R2_PUBLIC_URL=https://pub.r2.dev/podcast-saas

# ── Encryption (for API key storage) ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key-here-change-in-prod

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Pay-to-unlock locked videos and playlists. Get keys at https://dashboard.stripe.com/apikeys
# Leave STRIPE_SECRET_KEY blank to disable billing entirely (paywall hidden, lock UI hidden).
STRIPE_SECRET_KEY=sk_test_...
# Public key — also expose to the frontend as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY below.
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret — from `stripe listen` (dev) or the Dashboard → Webhooks (prod).
# Endpoint: POST {BACKEND_API_URL}/api/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission kept on each sale (0–100). The creator receives the rest.
PLATFORM_FEE_PERCENT=15

# ── Trigger.dev ───────────────────────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_...
TRIGGER_API_URL=https://api.trigger.dev

# ── Ingestion services ────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
GROQ_API_KEY=gsk_...

# Optional PDF extraction backends (used by PDFIngester as fallbacks; leave blank
# to disable). DOCLING_URL points at a running Docling HTTP service; LlamaParse
# is a hosted parsing API (https://cloud.llamaindex.ai).
DOCLING_URL=
LLAMAPARSE_API_KEY=

# ── Dev only ──────────────────────────────────────────────────────────────────
# Used by client-web dev helper scripts (dev-check / dev-watch); not needed at runtime.
PROJECT_ID=

# ── App URLs ──────────────────────────────────────────────────────────────────
# BACKEND_API_URL must be the backend's PUBLIC origin in production: simulation files
# are served to the browser through this origin's /sim-public/* proxy (Supabase's public
# bucket force-downgrades text/html → text/plain, so an iframe can't load the bucket URL
# directly). If unset in prod, sim iframes resolve to http://localhost:8080 and break.
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_API_URL=http://localhost:8080

# ── Course publishing (Phase 2) ───────────────────────────────────────────────
# Public canonical host for /c/ course & lesson URLs, sitemaps, OG images AND
# creator permalinks ({PUBLIC_SITE_URL}/{slug}, migration 043). Point this at the
# real domain (e.g. https://science-of-awe.com) when deploying — permalinks and
# canonical URLs follow it automatically.
# Falls back to NEXT_PUBLIC_APP_URL when unset. Used by backend + client-web.
PUBLIC_SITE_URL=http://localhost:3000
# Brand name used in SEO fallbacks, JSON-LD Organization and OG images.
PUBLIC_BRAND_NAME=Interactive Video Studio
# Conditional legacy /v and /pl → /c redirects. Keep DISABLED until the new /c
# pages are manually verified in each environment.
COURSE_LEGACY_REDIRECTS_ENABLED=false
# On-demand revalidation webhook (client-web /api/revalidate). Backend posts
# invalidation targets here on course/lesson change. Leave URL unset to no-op.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated emails that are auto-granted admin on every login (no SQL needed)
ADMIN_EMAILS=your-email@gmail.com

# ── Admin panel auth bypass (dev only) ────────────────────────────────────────
# Default is bypass ON (no access check). Set to 'false' to enforce admin-only.
NEXT_PUBLIC_ADMIN_BYPASS=true

# ── Simulation runtime switches ───────────────────────────────────────────────
# Each of these resolves in three steps: this env var, then the matching column on
# `admin_settings`, then the built-in default. Setting one HERE PINS it — the admin console can
# still be changed but the env value keeps winning, so leave these unset in production unless you
# are deliberately overriding the console. All of them are also editable at /feature-flags.
#
# sim_pool_mode        single | adaptive   — how many simulation documents may stay resident.
#                                            `single` is the kill switch for pool-related leaks.
# sim_scheduler_mode   off | predictive    — prepare an upcoming section before the playhead lands.
# sim_transition_coordinator  true|false   — hold the video→simulation handoff until the simulation
#                                            has actually submitted a frame. Off restores the
#                                            previous handoff exactly. Ships OFF.
# sim_adaptive_quality        true|false   — let a simulation lower its own render quality.
# sim_boundary_sentinel       true|false   — watch the section boundary with rVFC.
# SIM_RUM_SAMPLE_RATE  0..1                — fraction of viewer sessions reporting timings; 0 stops
#                                            ingestion entirely.
#
# `rum_retention_days` (how long ingested telemetry is kept) has NO env override by design — it is
# console-only, on `admin_settings`, so a redeploy cannot silently change a data-retention period.
#
# These two are env-only; they have no admin_settings column and no console control:
# HLS_RETIRE_GRACE_HOURS      integer (>=1) — how long a superseded HLS run tree is kept before the
#                                             sweep deletes it. Unparseable values fall back to the
#                                             default rather than deleting early.
# PROJECT_DUPLICATE_MAX_BYTES integer       — ceiling on the total bytes one Duplicate Project may
#                                             copy, refused before any byte moves.
# SIM_POOL_MODE=
# SIM_SCHEDULER_MODE=
# SIM_TRANSITION_COORDINATOR=
# SIM_ADAPTIVE_QUALITY=
# SIM_BOUNDARY_SENTINEL=
# SIM_RUM_SAMPLE_RATE=
# HLS_RETIRE_GRACE_HOURS=
# PROJECT_DUPLICATE_MAX_BYTES=

# ── Avatar rollout switches (BOTH must stay `shadow`) ─────────────────────────
# These gate the Ask-the-Avatar capability and spend controls. They were undocumented here, which
# is how an operator ends up flipping one without knowing the ordering it depends on.
#
# AVATAR_CAPABILITY_MODE  shadow | enforce   (missing/unrecognised → shadow)
# AVATAR_BUDGET_MODE      shadow | enforce | off   (missing/unrecognised → shadow)
#
# DO NOT SET EITHER TO `enforce`. The external reviewer's ruling is explicit and ordered:
#   1. the atomic Postgres function + real concurrency/idempotency tests;
#   2. the asynchronous shadow observer (bounded queue, 1–2 workers) with loss/latency metrics;
#   3. the capability wired into EVERY client surface — direct, share, permalink, playlist, course
#      — including prefetch at page load, refresh, and reconnect;
#   4. a real end-to-end run with AVATAR_CAPABILITY_MODE=enforce while budget stays shadow;
#   5. only after the caps are calibrated and reviewed: AVATAR_BUDGET_MODE=enforce.
#
# Flipping capability enforce before step 3 gives every viewer a 401 on every avatar open.
#
# Note also: today's budget `shadow` still performs the full transaction in the user's request
# path and rolls back on a cap miss, so the over-cap tail is exactly what does NOT get recorded.
# Until the observer is rebuilt, shadow traffic is NOT a valid source for calibrating caps.
# `off` is not a silent default either — it loses the DB kill switch and meter, so it is an
# explicit operational decision, not a fallback.
# AVATAR_CAPABILITY_MODE=shadow
# AVATAR_BUDGET_MODE=shadow

# ── Queue concurrency overrides ───────────────────────────────────────────────
# Per-queue worker counts. Defaults live in backend-api/src/queue/pgBossDriver.ts; these override
# them. Both are clamped to a minimum of 1.
#
# QUEUE_CROP_CONCURRENCY    vertical-crop analysis. Default is now 1 — see the driver for why:
#                           crop is ffmpeg + detection, i.e. CPU-bound, and the production host has
#                           2 vCPU. Raising it needs a measured RSS/runtime run on that host first.
# QUEUE_EXPORT_CONCURRENCY  linear-video export. Default 1; export is the heaviest job here.
# QUEUE_CROP_CONCURRENCY=1
# QUEUE_EXPORT_CONCURRENCY=1

# ── Dubbing (ElevenLabs Dubbing v2) ───────────────────────────────────────────
# Multi-language audio for a project. Billed per minute of SOURCE media PER TARGET LANGUAGE, so the
# total multiplies — a 10-minute lesson into 5 languages is ~$110 from one button press.
#
# ELEVENLABS_DUBBING_WATERMARKED
#   Whether this account's plan watermarks dubbed audio. THE DEFAULT IS `true`, and it withholds
#   every dub from viewers. That is deliberate: the vendor exposes no watermark field on any v2
#   response — it is a property of the plan the API key belongs to — so it has to be declared, and
#   an unset variable must fail toward "nobody sees a watermarked video" rather than toward
#   shipping one. Set it to `false` ONLY after confirming the workspace is on a paid plan, and
#   after one short probe dub has been listened to.
# ELEVENLABS_DUBBING_WATERMARKED=false
#
# DUBBING_USD_PER_CREDIT
#   Sharpens the cost estimate shown before a run. Unset uses the vendor's headline rate, which is
#   the worst case (3,000 credits/min, the watermark-free default row) — deliberately pessimistic,
#   because a creator surprised upward by a bill is worse than one surprised downward.
# DUBBING_USD_PER_CREDIT=0.00011
#
# DUBBING_MONTHLY_BUDGET_CENTS
#   Per-user ceiling, in cents, over the UTC calendar month. Default 5000 ($50). Checked BEFORE the
#   vendor is called, because the vendor bills on job creation and offers no idempotency key — a
#   limit enforced afterwards is a report, not a limit. A zero, negative or malformed value falls
#   back to the default rather than disabling dubbing for everyone.
# DUBBING_MONTHLY_BUDGET_CENTS=5000
#
# DUBBING_BUDGET_EXEMPT_USER_IDS
#   Comma-separated user ids the ceiling never applies to — the operator's own account while
#   dubbing is owner-only.
# DUBBING_BUDGET_EXEMPT_USER_IDS=

# ── Upload ceilings ───────────────────────────────────────────────────────────
#
# Every multipart route caps the bytes it will accept, and the cap is enforced TWICE: the declared
# Content-Length is refused before a byte of body is read, and the stream is then counted and
# destroyed the moment it passes the ceiling. Without that, a route's only bound was nginx's
# MAX_UPLOAD_SIZE (deploy/.env, default 2g) — which is a transfer limit, not a memory one, and on
# a 2-vCPU host a single oversized POST is an out-of-memory kill of the whole API (security-007).
#
# Each value is BYTES. The effective ceiling is the smaller of the value below and what nginx
# passes, so raising one of these without raising MAX_UPLOAD_SIZE changes nothing. A malformed or
# non-positive value falls back to the default rather than removing the limit.
#
# Defaults are sized well above any real payload, because a guard that refuses legitimate work is
# a bug wearing a guard's clothes.
#
# MAX_AUDIO_UPLOAD_BYTES       1 GiB    Spooled to disk; heap cost is one 64 KiB chunk.
# MAX_CORPUS_UPLOAD_BYTES      1 GiB    Same shape; accepts audio and video.
# MAX_PODCAST_SOURCE_BYTES   100 MiB    Must stay in the heap — the document parsers take a Buffer.
# MAX_IMAGE_UPLOAD_BYTES      25 MiB    Project images, their replace path, and playlist banners.
# MAX_THUMBNAIL_UPLOAD_BYTES  10 MiB    Project thumbnails.
# MAX_AVATAR_FACE_BYTES        8 MiB    Avatar circle faces.
# MAX_KNOWLEDGE_DOC_BYTES     25 MiB    Avatar knowledge documents forwarded to the vendor.
# MAX_SIM_DOWNLOAD_BYTES     256 MiB    Simulation package DOWNLOAD; matches zipGuard's
#                                       uncompressed ceiling, not the compressed upload limit.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info