  {
    "film": 3,
    "scene": "4",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 20,
    "t1": 26,
    "text": "Simple UI — only your buttons. Auto Script — it demos itself. …Generate."
  },
  {
    "film": 3,
    "scene": "5",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 26,
    "t1": 32,
    "text": "Second thoughts? Type them. Bigger timeline… hide that toggle. It remembers — and rewires."
