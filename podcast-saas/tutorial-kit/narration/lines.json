    "scene": "2",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 3,
    "t1": 13,
    "text": "Hit Create link. One link — three doors: your video… a podcast that answers voice questions… your whole library, browsable."
