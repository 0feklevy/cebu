  {
    "film": 3,
    "scene": "8",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 44,
    "t1": 51,
    "text": "Whatever you've built… drop it in. Put it on stage. — Flow Video."
