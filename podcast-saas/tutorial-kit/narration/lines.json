  {
    "film": 2,
    "scene": "9",
    "role": "narrator",
    "kind": "LIVE-WINDOW",
    "window": "solarSystem",
    "cont": true,
    "t0": 57,
    "t1": 63,
    "text": "Now speed up time. Your viewers get exactly this — nothing in their way."
  },
  {
    "film": 2,
    "scene": "10",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 63,
    "t1": 70,
    "text": "Hit Create link. That one link is the whole thing — the video, an audio edition, your library."
  },
  {
    "film": 2,
    "scene": "11",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 70,
    "t1": 77,
    "text": "This project? Already yours. The solar system below sits on your timeline right now."
  },
  {
    "film": 2,
    "scene": "12",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 77,
    "t1": 83,
    "text": "Change one word of the prompt. Hit Generate… and watch it obey. — Flow Video."
  },
  {
    "film": 3,
    "scene": "1",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 0,
    "t1": 6,
    "text": "Anything that runs in a browser… can run inside your video."
  },
  {
    "film": 3,
    "scene": "2",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 6,
    "t1": 12,
    "text": "Got one? Zip it. Drop it. That's the entire import."
  },
  {
    "film": 3,
    "scene": "3",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 12,
    "t1": 20,
    "text": "Drag across the timeline where it belongs. Then tell it, plain words, what viewers should do."
