    "film": 5,
    "scene": "3",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 13,
    "t1": 20,
    "text": "Claim your address, and publish. That's the link for the slide, the bio, the syllabus."
  },
