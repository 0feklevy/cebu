    "film": 5,
    "scene": "4",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 20,
    "t1": 27,
    "text": "Now open Settings. Got a team? Invite them — they edit, you stay the owner."
  },
