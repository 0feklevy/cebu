    "film": 5,
    "scene": "5",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 27,
    "t1": 33,
    "text": "And Access decides who watches. Everyone… link-holders… or just you."
  },
  {
    "film": 5,
    "scene": "6",
    "role": "narrator",
    "kind": "VIDEO",
    "window": null,
    "cont": false,
    "t0": 33,
    "t1": 39,
    "text": "Publish public, and viewers need nothing. No app. No account. No download."
  },
