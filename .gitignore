node_modules/
.env
*.env.local
# Operational .env backups taken on a host before a risky change. They are never committed, and
# leaving them merely UNTRACKED made them show up in `git status --porcelain` — which is what the
# release's CHECK_REMOTE_STATUS reads, so one stray backup on the VM blocked production deploys
# twice. Ignoring them keeps the safety check meaningful: a dirty tree then means real work.
.env.backup*
*.env.backup*
.next/
dist/
build/
*.log
.DS_Store

# TypeScript incremental build caches (regenerated by tsc; not source)
*.tsbuildinfo

# Reference projects — have their own repos, not backed up here
fiji/
podcast-saas/interactive-podcast-react/
darwin-avatar/

# Local nested repos of personal projects — NEVER tracked (an undeclared gitlink here
# broke actions/checkout: "No url found for submodule path 'myprojects' in .gitmodules")
/myprojects/

# Release pipeline outputs ($ART in the workflows; also written by local release-cli runs).
# Must be ignored or release preflight flags its own plan/state files as a dirty tree.
/release-artifacts/

# Ship conductor run directories — downloaded logs, artifacts and reports for one
# shipment. Local evidence, not source; and ship's own preflight refuses to start on a
# dirty tree, so tracking these would make every shipment block the next one.
/.claude/ship/

# Trusted simulation dependency packs are VENDORED ON PURPOSE and must ship in the repo/image:
# the capture container has no network, so `build/three.module.js` being swallowed by the generic
# `build/` rule above would publish a registry whose files do not exist — every capture would fail
# at materialise() with "vendored file missing on disk".
!podcast-saas/backend-api/vendor/sim-deps/**

# Local pre-sync backups and archived artifacts (never for the repo)
_archive/
